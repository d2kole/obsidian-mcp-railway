# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Build & coverage outputs
coverage/
test-results/
playwright-report/

# Local env files — never commit real secrets
# .env / .env.* hold GITHUB_PAT, OAUTH_CLIENT_SECRET, SESSION_ENCRYPTION_KEY,
# and PERSONAL_AUTH_TOKEN. A single accidental commit is a P0 security
# incident. .env.example is the only env file allowed in git.
.env
.env.*
!.env.example

# OAuth persistence file — holds issued auth codes and revoked-token IDs.
.oauth-store.json
**/.oauth-store.json

# Cryptographic material — private keys, certs, PKCS bundles.
*.key
*.pem
*.p12
*.pfx
*.crt

# Temp vault caches created by dev-bootstrap.sh
/tmp/obsidian-mcp-dev/
.dev-vault/

# Replit
.cache/
.local/
