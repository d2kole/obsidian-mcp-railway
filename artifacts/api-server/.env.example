# obsidian-mcp-railway — environment variables
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env — it is git-ignored. This file (.env.example) is safe to commit.
#
# Production (Railway): set all "Required" vars as Sealed Variables in the
# Railway dashboard. See OPERATIONS.md for the full runbook.

# ---------------------------------------------------------------------------
# Vault / Git
# ---------------------------------------------------------------------------

# HTTPS URL of your private Obsidian vault repo (the **vault content** repo).
# This is NOT the service code repo. The service code lives at
# d2kole/obsidian-mcp-railway and is built by Railway directly from GitHub.
# Production example: https://github.com/d2kole/obsidian-my-second-brain.git
# Local dev: leave blank — scripts/dev-bootstrap.sh creates a local file:// repo.
VAULT_REPO_URL=

# Branch to track. Default: main
VAULT_BRANCH=main

# Fine-grained GitHub PAT with contents: read+write on the vault repo only.
# Generate at https://github.com/settings/personal-access-tokens
# Recommended expiry: 90 days. See OPERATIONS.md for rotation runbook.
# Local dev: leave blank — bootstrap sets a placeholder.
GITHUB_PAT=

# Folders Claude is allowed to write to (comma-separated, vault-relative).
# Default when unset: read-only. Production example: 00-Inbox,Journal,Captures
OBSIDIAN_WRITE_PATHS=00-Inbox,Journal

# Directory where the vault working copy is cached.
# Production: /vault-cache (Railway persistent volume, mounted by railway.toml)
# Local dev: leave blank — bootstrap uses /tmp/obsidian-mcp-dev/cache
VAULT_CACHE_DIR=

# ---------------------------------------------------------------------------
# OAuth / Auth
# ---------------------------------------------------------------------------

# OAuth client identifier returned by /oauth/register.
# Default: obsidian-mcp-railway. No need to change unless you run multiple instances.
OAUTH_CLIENT_ID=obsidian-mcp-railway

# 32-byte secret used to sign access tokens.
# Generate: openssl rand -base64 32
OAUTH_CLIENT_SECRET=

# 32-byte secret for session integrity checks.
# Generate: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# The single-user password typed into the OAuth login form.
# Generate: openssl rand -base64 24
PERSONAL_AUTH_TOKEN=

# Access token lifetime in seconds. Default: 86400 (24 h)
OAUTH_ACCESS_TOKEN_TTL_SEC=86400

# Comma-separated allowlist of redirect_uri prefixes.
# Default: https://claude.ai/,https://claude.com/,http://localhost,http://127.0.0.1
OAUTH_ALLOWED_REDIRECT_PREFIXES=https://claude.ai/,https://claude.com/,http://localhost,http://127.0.0.1

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Public base URL (used in OAuth metadata responses).
# Production: https://<your-railway-domain>
# Local dev: http://localhost:3000
BASE_URL=http://localhost:3000

# HTTP port. Railway injects PORT automatically; do not set in Railway.
PORT=3000

# Rolling-window write cap per OAuth session. Default: 20
MAX_WRITES_PER_HOUR=20

# ---------------------------------------------------------------------------
# Journal
# ---------------------------------------------------------------------------

JOURNAL_PATH_TEMPLATE=Journal/{{date}}.md
JOURNAL_DATE_FORMAT=YYYY-MM-DD
JOURNAL_ACTIVITY_SECTION=## Activity

# ---------------------------------------------------------------------------
# Storage paths (advanced — usually leave as defaults)
# ---------------------------------------------------------------------------

# Where OAuth auth codes and revoked-token IDs are persisted.
# Must live on the persistent volume so it survives Railway restarts.
# Default: ${VAULT_CACHE_DIR}/.oauth-store.json
OAUTH_STORE_PATH=
