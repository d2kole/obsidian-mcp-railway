{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:http": "node --enable-source-maps ./dist/index.mjs http",
    "start:stdio": "node --enable-source-maps ./dist/index.mjs stdio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "echo 'lint: no eslint config wired yet (see TESTING.md)' && exit 0",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "verify:test-infra": "pnpm run typecheck && vitest run tests/unit/smoke.test.ts tests/integration/smoke.test.ts tests/integration/git-remote.fixture.test.ts && playwright test tests/e2e/healthz.spec.ts",
    "verify:vault": "vitest run tests/integration/vault-service.test.ts src/vault/service.test.ts src/vault/edits.test.ts --coverage --coverage.include='src/vault/**' --coverage.thresholds.lines=90 --coverage.thresholds.statements=90 --coverage.thresholds.functions=90 --coverage.thresholds.branches=80",
    "verify:write-path": "vitest run tests/unit/write-path.test.ts --coverage --coverage.include='src/vault/write-path.ts' --coverage.include='src/vault/errors.ts' --coverage.thresholds.lines=95 --coverage.thresholds.statements=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=95",
    "verify:rate-limit": "vitest run src/mcp/rateLimit.test.ts tests/integration/rate-limit.test.ts --coverage --coverage.include='src/mcp/rateLimit.ts' --coverage.thresholds.lines=95 --coverage.thresholds.statements=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=95",
    "verify:oauth": "vitest run src/oauth/oauth.test.ts src/oauth/store.persistence.test.ts --coverage --coverage.include='src/oauth/**' --coverage.thresholds.lines=90 --coverage.thresholds.branches=90"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "fuse.js": "^7.0.0",
    "jose": "^5.9.6",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "simple-git": "^3.27.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^2.1.9"
  }
}
